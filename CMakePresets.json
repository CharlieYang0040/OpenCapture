{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "vs2022-x64-debug",
      "inherits": "ninja-base",
      "displayName": "Ninja + MSVC x64 Debug (global vcpkg)",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022-x64-release",
      "inherits": "ninja-base",
      "displayName": "Ninja + MSVC x64 Release (global vcpkg)",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "repo-ninja-x64-debug",
      "inherits": "ninja-base",
      "displayName": "Ninja + MSVC x64 Debug (repository-local tools)",
      "toolchainFile": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe"
      }
    },
    {
      "name": "repo-ninja-x64-release",
      "inherits": "ninja-base",
      "displayName": "Ninja + MSVC x64 Release (repository-local tools)",
      "toolchainFile": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe"
      }
    },
    {
      "name": "vs2022-core-tests",
      "inherits": "ninja-base",
      "displayName": "Ninja core tests (no external dependencies)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENCAPTURE_BUILD_APP": "OFF",
        "OPENCAPTURE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2022-x64-debug", "configurePreset": "vs2022-x64-debug" },
    { "name": "vs2022-x64-release", "configurePreset": "vs2022-x64-release" },
    { "name": "repo-ninja-x64-debug", "configurePreset": "repo-ninja-x64-debug" },
    { "name": "repo-ninja-x64-release", "configurePreset": "repo-ninja-x64-release" },
    { "name": "vs2022-core-tests", "configurePreset": "vs2022-core-tests" }
  ],
  "testPresets": [
    {
      "name": "repo-ninja-x64-debug",
      "configurePreset": "repo-ninja-x64-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2022-core-tests",
      "configurePreset": "vs2022-core-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
